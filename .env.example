# GSPMH settings. Copy to .env and replace every CHANGE_ME (install.sh / install.ps1 generate them for you).
# Keep .env private: it holds the database password and the keys that protect stored GeoServer passwords.

# Release to run (a version such as 1.0.0, or latest)
GSPMH_VERSION=latest

# Address people open, without a trailing slash (used for CORS and sign-in redirects)
PUBLIC_URL=http://localhost
WEB_PORT=80

# PostgreSQL (bundled container)
POSTGRES_DB=gspmh
POSTGRES_USER=gspmh_user
POSTGRES_PASSWORD=CHANGE_ME

# At least 32 random characters each. NEVER change ENCRYPTION_KEY after the first start:
# the stored GeoServer and VPN passwords could no longer be read.
JWT_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# Optional
INSTALLATION_NAME=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_PACKAGES=50

# VPN tunnels only (docker-compose.vpn.yml): group of /var/run/docker.sock on the host
DOCKER_GID=999
